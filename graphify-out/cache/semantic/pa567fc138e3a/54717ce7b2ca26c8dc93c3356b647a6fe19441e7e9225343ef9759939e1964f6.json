{"nodes": [{"id": "docs_screenshot_aurora_night_landscape", "label": "Aurora Night Landscape Screenshot", "file_type": "image", "source_file": "Docs/Screenshot.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HUD-less in-game still from a snowy ridge looking slightly up. The sky, not the terrain, is the subject: a green aurora band in a starry night with broken clouds."}, {"id": "docs_screenshot_aurora_borealis", "label": "Aurora Borealis", "file_type": "concept", "source_file": "Docs/Screenshot.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_screenshot_vertical_curtain_rays", "label": "Vertical Curtain Rays", "file_type": "rationale", "source_file": "Docs/Screenshot.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The green band is built from many vertical columns that drop toward the horizon, the curtain morphology of a real aurora rather than a single sprite or horizontal wash."}, {"id": "docs_screenshot_emerald_green_emission", "label": "Emerald Green Emission", "file_type": "rationale", "source_file": "Docs/Screenshot.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Peak color is saturated emerald in the mid-sky; edges fall off to teal and then the dark blue of the night sky. No red or purple band is visible."}, {"id": "docs_screenshot_starfield", "label": "Night Starfield", "file_type": "concept", "source_file": "Docs/Screenshot.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_screenshot_broken_night_clouds", "label": "Broken Night Clouds", "file_type": "concept", "source_file": "Docs/Screenshot.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_screenshot_snow_capped_mountains", "label": "Snow-Capped Mountain Foreground", "file_type": "concept", "source_file": "Docs/Screenshot.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_screenshot_night_sky", "label": "Night Sky", "file_type": "concept", "source_file": "Docs/Screenshot.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_screenshot_additive_transparency", "label": "Additive Aurora Transparency", "file_type": "rationale", "source_file": "Docs/Screenshot.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Point stars remain visible through the green curtains, so the aurora is composited additively over the sky instead of as an opaque sheet."}, {"id": "docs_screenshot_cloud_occlusion", "label": "Clouds Occlude Aurora", "file_type": "rationale", "source_file": "Docs/Screenshot.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark broken clouds sit in front of parts of the green band; glow shows only in gaps. The aurora is a sky effect behind weather, not a post overlay on the whole frame."}, {"id": "docs_screenshot_sky_only_composite", "label": "Sky-Only Aurora Composite", "file_type": "rationale", "source_file": "Docs/Screenshot.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snow and rock stay in unlit night values; the aurora does not light the terrain. The effect is confined to the sky behind the ridge silhouette."}], "edges": [{"source": "docs_screenshot_aurora_night_landscape", "target": "docs_screenshot_aurora_borealis", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/Screenshot.png", "source_location": null