ource_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Harmony postfix on MyAtmosphereRenderer.RenderGBuffer is the first unconditional transparent-stage step, so aurora composites over atmosphere haze while clouds and billboards composite over the aurora. Clouds Render is gated by a debug override."}, {"id": "docs_plan_skip_unity_depth_plumbing", "label": "Skip Unity Depth Reconstruction", "file_type": "rationale", "source_file": "Docs/Plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unity repo scene-depth reconstruction is dead code never used; SE uses its own depth occlusion against resolved scene depth."}, {"id": "docs_plan_spherical_not_box", "label": "Spherical Shell Instead of Box", "file_type": "rationale", "source_file": "Docs/Plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unity marches an axis-aligned box in a flat sky; SE planets are spherical, so the volume is a spherical shell segment between inner and outer radii, masked to a polar latitude band."}, {"id": "docs_plan_fullscreen_v1", "label": "Fullscreen Pass for v1", "file_type": "rationale", "source_file": "Docs/Plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MyScreenPass.DrawFullscreenQuad plus a custom pixel shader is enough for v1 because the ray/shell miss early-outs in a few ALU ops; a proxy mesh is a later optimization."}, {"id": "docs_plan_game_shader_registry", "label": "Use Game Shader Registry", "file_type": "rationale", "source_file": "Docs/Plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MyPixelShaders.Create registers ps_5_0 __pixel_shader bytecode so live reload and device-reset recompile come for free, unlike raw D3DCompiler."}, {"id": "docs_plan_bounded_step_loop", "label": "Bounded Fixed-Step March", "file_type": "rationale", "source_file": "Docs/Plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quality presets use a fixed 24/48/96 step loop instead of the Unity while loop so GPU cost is bounded."}, {"id": "docs_plan_game_render_thread_snapshot", "label": "Game-to-Render Snapshot", "file_type": "rationale", "source_file": "Docs/Plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The render patch must not touch game-world objects. Plugin.Update builds an immutable AuroraSnapshot on the game thread; the render thread reads the latest snapshot and camera-relative planet center."}, {"id": "docs_plan_fail_closed_renderer", "label": "Fail-Closed Renderer", "file_type": "rationale", "source_file": "Docs/Plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every patch entry wraps in try/catch; on first exception the renderer disables for the session and logs once so a broken visual plugin never crashes or spams the render loop."}, {"id": "docs_plan_march_both_shell_segments", "label": "March Both Shell Segments", "file_type": "rationale", "source_file": "Docs/Plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marching only the first shell segment left a hard edge along the inner sphere tangent when the camera was inside the shell; both segments are marched as one continuous arc length."}, {"id": "docs_plan_azimuthal_noise_uv", "label": "Azimuthal Noise UV", "file_type": "rationale", "source_file": "Docs/Plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Longitude/latitude noise UVs smeared into radial spokes at the pole; sampling on the azimuthal tangent-plane projection also removes the \u00b1\u03c0 seam."}], "edges": [{"source": "docs_plan", "target": "docs_plan_volumetric_aurora", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/Plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_plan", "target": "docs_plan_roy_theunissen_unity", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/Plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_plan_volumetric_aurora", "target": "docs_plan_roy_theunissen_unity", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/Plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_plan_volumetric_aurora", "target": "docs_plan_raymarching", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/Plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_plan_volumetric_aurora", "target": "docs_plan_difference_clouds", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/Plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_plan_volumetric_aurora", "target": "docs_plan_two_point_five_d_volume", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/Plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_plan_volumetric_aurora", "target": "docs_plan_color_ramp_lut", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/Plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_plan_volumetric_aurora", "target": "docs_plan_additive_hdr_blending", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/Plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_plan_